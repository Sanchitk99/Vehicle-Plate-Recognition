# Core backend selection
PLATE_DETECTOR_BACKEND=local
# PLATE_WEIGHTS_PATH=runs/detect/plate_train/weights/best.pt
# ROBOFLOW_API_KEY=your_key_if_using_roboflow

# ANPR runtime tuning (production)
ANPR_DEBUG=0
ANPR_SAVE_DEBUG=0
ANPR_PROFILE_LOG=0
ANPR_FRAME_STRIDE=2
ANPR_MAX_PLATES=5
ANPR_IMGSZ=640
ANPR_DET_CONF=0.30
ANPR_OCR_CONF=0.30
ANPR_OCR_CONF_LOW=0.40

# Plate fallback detection inside ANPR
ANPR_PLATE_FALLBACK_IMGSZ=768
ANPR_PLATE_FALLBACK_CONF_FACTOR=0.60
ANPR_PLATE_FALLBACK_MIN_CONF=0.10
ANPR_PLATE_FALLBACK_AUGMENT=1
ANPR_PLATE_FALLBACK_MAX_DET=100

# OCR / temporal stability
ANPR_OCR_CACHE_IOU=0.75
ANPR_OCR_FALLBACK_CONF=0.55
ANPR_FINAL_MIN_CONF=0.50
ANPR_FINAL_MIN_VOTE=0.60
ANPR_STABLE_CONFIRM_FRAMES=3
ANPR_STABLE_LOCK_FRAMES=10
ANPR_NEW_PLATE_CONFIRM_FRAMES=3
ANPR_ENABLE_TRACKING=1

# OCR backend options
OCR_FORCE_CPU=0
OCR_CPU_THREADS=2
